<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark application theme -->
    <style name="Theme.PlugPro" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorSecondary">#E2E8F0</item>
        <item name="colorSurface">#1E293B</item>
        <item name="android:colorBackground">#0F172A</item>

        <item name="android:statusBarColor">#1E293B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#1E293B</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="materialCardViewStyle">@style/Widget.PlugPro.CardView</item>
        <item name="materialButtonStyle">@style/Widget.PlugPro.Button</item>
    </style>

    <style name="Theme.PlugPro.Splash" parent="Theme.PlugPro">
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorBackground">@color/primary</item>
    </style>

    <style name="Widget.PlugPro.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_radius_medium</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#334155</item>
        <item name="cardBackgroundColor">#1E293B</item>
    </style>

    <style name="Widget.PlugPro.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/corner_radius_medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
